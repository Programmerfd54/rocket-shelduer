# База данных (PostgreSQL)
#
# Локально без Docker: localhost и свои user/password.
# Docker Compose: хост БД — имя сервиса `postgres`, порт 5432. Пароль должен совпадать с POSTGRES_PASSWORD.
#
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=сгенерируйте_надёжный_пароль
# POSTGRES_DB=rocketchat_scheduler
#
# Пример для docker compose (подставьте тот же пароль):
# DATABASE_URL="postgresql://postgres:сгенерируйте_надёжный_пароль@postgres:5432/rocketchat_scheduler"
#
DATABASE_URL="postgresql://user:password@localhost:5432/rocketchat_scheduler"

# Секрет для JWT-токенов сессии. В проде — длинная случайная строка.
JWT_SECRET="your-secret-key"

# При деплое по HTTP (Docker без HTTPS): COOKIE_SECURE=false, иначе вход не сохраняется.
# COOKIE_SECURE="false"

# Ключ шифрования паролей пространств (Rocket.Chat).
# В проде обязательно задать отдельный ключ (не использовать JWT_SECRET).
# Минимум 32 символа; иначе используется JWT_SECRET (не рекомендуется в проде).
ENCRYPTION_KEY=""

# Опционально: для cron-задач (отправка сообщений, очистка архивов)
# CRON_SECRET=""

# Опционально: для деплоя (ссылки приглашений и т.д.)
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
# APP_URL="https://your-domain.com"

# Опционально: для внешнего мониторинга GET /api/health (Docker, K8s). Если задано, запрос должен содержать ?secret=HEALTH_CHECK_SECRET
# HEALTH_CHECK_SECRET=""

# Опционально: Sentry (отправка ошибок)
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
