# База данных (PostgreSQL)
#
# Локально без Docker: localhost и свои user/password.
# Docker Compose: хост БД — имя сервиса `postgres`, порт 5432. Пароль должен совпадать с POSTGRES_PASSWORD.
#
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=сгенерируйте_надёжный_пароль   # openssl rand -hex 24
# POSTGRES_DB=rocketchat_scheduler
#
# Пример для docker compose (подставьте тот же пароль):
# DATABASE_URL="postgresql://postgres:сгенерируйте_надёжный_пароль@postgres:5432/rocketchat_scheduler"
#
DATABASE_URL="postgresql://user:password@localhost:5432/rocketchat_scheduler"

# Секрет для JWT-токенов сессии: openssl rand -base64 32
# Значение ниже — ТОЛЬКО для локальной разработки: в production приложение с ним не запустится.
JWT_SECRET="your-secret-key"

# При деплое по HTTP (Docker без HTTPS): COOKIE_SECURE=false, иначе вход не сохраняется.
# COOKIE_SECURE="false"

# Ключ шифрования паролей/токенов пространств (Rocket.Chat): openssl rand -base64 32
# В production обязателен (без него приложение не стартует), отдельный от JWT_SECRET.
# НЕ меняйте на работающей БД: старый ключ перенесите в ENCRYPTION_KEY_PREVIOUS (ротация).
ENCRYPTION_KEY=""
# ENCRYPTION_KEY_PREVIOUS=""   # старые ключи через запятую — только для расшифровки

# Секрет cron-эндпоинтов (/api/cron/*): openssl rand -hex 32. В production обязателен для внешнего cron.
# Если не задан в production — работает встроенный cron (node-cron), а /api/cron/* отвечают 503.
# CRON_SECRET=""

# Для деплоя (ссылки приглашений, allow-list Origin для CSRF/CORS)
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
# APP_URL="https://your-domain.com"
# Дополнительные разрешённые Origin (через запятую), если фронтенд открывается с другого домена
# CORS_ALLOWED_ORIGINS=""

# Сколько доверенных обратных прокси перед приложением (для определения IP клиента и rate limit).
# nginx/Caddy на том же хосте = 1 (по умолчанию), Cloudflare → nginx = 2.
# TRUSTED_PROXY_HOPS="1"

# Docker: на каком адресе хоста публиковать порт 4001 (127.0.0.1 — только для локального прокси)
# APP_BIND_ADDRESS="127.0.0.1"

# Привязка сессии к IP клиента (true — сессия завершается при смене IP)
# SESSION_BIND_IP="false"

# Публичная регистрация (без приглашения). По умолчанию выключена.
# ALLOW_PUBLIC_REGISTER="false"

# Первый Lead_SUP (scripts/create-superuser.ts): создаётся, только если LEAD_SUP в БД ещё нет.
# Без SUPERUSER_PASSWORD генерируется случайный пароль (печатается один раз), смена при первом входе обязательна.
# SUPERUSER_LOGIN="admin"
# SUPERUSER_PASSWORD=""

# Для мониторинга GET /api/health (Docker, K8s). В production обязателен:
# заголовок X-Health-Secret: <значение> (или устаревший ?secret=<значение>)
# HEALTH_CHECK_SECRET=""

# Разрешённые внутренние хосты Rocket.Chat (SSRF-защита блокирует частные сети по умолчанию)
# SSRF_ALLOWED_HOSTS="rc.corp.example,10.0.0.5"

# Суточная квота загрузок справки (за последние 24 ч, считается по файлам в public/help-uploads)
# HELP_UPLOAD_DAILY_MAX_FILES="200"
# HELP_UPLOAD_DAILY_MAX_MB="1024"

# Docker: лимит памяти контейнера приложения (docker-compose mem_limit)
# APP_MEM_LIMIT="1536m"

# Опционально: Sentry (отправка ошибок)
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# ── Необязательные (существующий .env работает без них) ──────────────────────────────
# Порт, на котором контейнер слушает снаружи (по умолчанию 3000) и адрес привязки (127.0.0.1 — только для прокси на этом хосте)
# APP_PORT=3000
# APP_BIND_ADDRESS=127.0.0.1
# Секреты для /api/cron/* и /api/health (рекомендуется задать: openssl rand -hex 32)
# CRON_SECRET=
# HEALTH_CHECK_SECRET=
# Сколько прокси стоит перед приложением (определение IP клиента для лимитов): 1 — nginx/Caddy; 2 — Cloudflare + nginx
# TRUSTED_PROXY_HOPS=1
# Публичный адрес (ссылки-приглашения, проверка Origin)
# NEXT_PUBLIC_APP_URL=https://example.org
# Хосты Rocket.Chat во внутренней сети/VPN, к которым разрешено подключаться (иначе блокируются защитой от SSRF)
# SSRF_ALLOWED_HOSTS=rc.internal.example
# HTTP-доступ без TLS (cookie без флага Secure)
# COOKIE_SECURE=false
