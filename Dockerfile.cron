# Минимальный образ для cron — alpine + curl, ~10MB вместо 2.7GB
FROM alpine:3.19
RUN apk add --no-cache curl \
    && adduser -D -H -u 10001 cronrunner
USER cronrunner
# APP_HOST=app (deploy) или web (root docker-compose)
ENV APP_HOST=app
# Заголовок с секретом читается из stdin (-H @-): CRON_SECRET не виден в списке процессов (ps)
CMD ["sh", "-c", "while true; do printf 'Authorization: Bearer %s\\n' \"$CRON_SECRET\" | curl -sf -o /dev/null -H @- \"http://$APP_HOST:3000/api/cron/send-messages\" || true; sleep 60; done"]
